# Copy to .env. Development defaults; production refuses OTP_DEV_MODE, the console SMS provider and missing keys.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# "Aide & support" in the app
SUPPORT_PHONE=777902880
SUPPORT_EMAIL=ugb.campus@gmail.com
# The first administrator, created by `npm run migrate` / a deploy if no account uses this phone (never changed after).
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_PASSWORD=
DOCS_ENABLED=true
# Expo web in development (the mobile app itself needs no CORS).
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:19006
TRUST_PROXY=false

MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DB=ugb_connect
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=ugb

# `npm run keys` prints a fresh Ed25519 pair (base64 PEM). Without them, development uses ephemeral keys.
JWT_KID=dev-1
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_ABSOLUTE_DAYS=90

# OTP: with OTP_DEV_MODE the code is always 1234 (the app shows it). Set it to false to send real random codes.
OTP_DEV_MODE=true
OTP_LENGTH=4
OTP_PEPPER=change-me-to-a-random-string-of-at-least-32-chars
# SMS: console (written to the worker log) or twilio.
SMS_PROVIDER=console
# Twilio: the account SID, then an API key (SID + secret) or the auth token, then the sender:
# a Twilio number (+1…) / an approved sender name, or a Messaging Service SID.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=

# Payments: simulated Wave / Orange Money (development only, refused in production).
PAYMENTS_SIMULATOR=true
# Sunu Taxi seats paid in the app (Wave / Orange Money). false: a seat is a reservation, paid in the taxi.
TAXI_ONLINE_PAYMENT=false
# SIMULATOR_WEBHOOK_SECRET=
# Public base URL used in checkout links. Empty: the host the app called (phone on the same Wi-Fi).
# PUBLIC_API_URL=

# Push notifications: expo (Expo push service) or log (worker log only).
PUSH_PROVIDER=expo
# EXPO_ACCESS_TOKEN=

# Uploaded images: local (./var/media, served by the API on /media) or s3 (AWS S3 / Cloudflare R2; required in production).
MEDIA_STORAGE=local
# MEDIA_DIR=./var/media
# MEDIA_PUBLIC_URL=https://media.example.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
