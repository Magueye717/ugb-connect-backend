{
  "name": "ugb-connect-backend",
  "version": "0.1.0",
  "private": true,
  "description": "UGB Connect backend: Fastify modular monolith",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts api",
    "dev:worker": "tsx watch --env-file=.env src/main.ts worker",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js api",
    "start:worker": "node dist/main.js worker",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "seed": "tsx --env-file=.env scripts/seed/index.ts",
    "keys": "tsx scripts/keys/generate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.5",
    "argon2": "^0.45.1",
    "bullmq": "^6.5.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "mongodb": "^7.8.0",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "typebox": "^1.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
